# Influx-Korrektur – configuration / Konfiguration
# Copy to .env / nach .env kopieren. See README.md for all options / alle Optionen siehe README.de.md.

# --- InfluxDB 1.x (e.g. Home Assistant add-on / z. B. HA-Add-on) ---
INFLUX_URL=http://192.168.1.10:8086
INFLUX_DB=homeassistant
INFLUX_USER=homeassistant
INFLUX_PASSWORD=changeme

# --- InfluxDB 2.x only (instead of user/password) / nur 2.x (statt Benutzer/Passwort) ---
# INFLUX_TOKEN=
# INFLUX_ORG=
# INFLUX_BUCKET=homeassistant

# --- Behaviour / Verhalten ---
TZ=Europe/Berlin
DEFAULT_MEASUREMENT=kWh
DEFAULT_DAYS=60

# Data gap threshold in hours / Datenloch ab x Stunden ohne Wert
HOLE_HOURS=3

# Counter: daily consumption > factor x median; gauge: factor x MAD (Hampel filter)
# Zähler: Tagesverbrauch > Faktor x Median; Messwert: Faktor x MAD (Hampel-Filter)
OUTLIER_FACTOR=5

# Gauge mode: grid for gap filling in minutes / Messwert: Raster der Füllpunkte in Minuten
GRID_MINUTES=60

# Field marking manually written points; empty = off / Kennzeichnung manueller Punkte; leer = aus
MARK_FIELD=korrektur_str
