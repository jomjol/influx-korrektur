# --- InfluxDB (HA-Add-on, InfluxDB 1.8) ---
INFLUX_URL=http://192.168.178.43:8086
INFLUX_DB=homeassistant
INFLUX_USER=homeassistant
INFLUX_PASSWORD=geheim

# --- nur bei InfluxDB 2.x (statt USER/PASSWORD) ---
# INFLUX_TOKEN=
# INFLUX_ORG=
# INFLUX_BUCKET=homeassistant

# --- Verhalten ---
TZ=Europe/Berlin
DEFAULT_MEASUREMENT=kWh
DEFAULT_DAYS=60
HOLE_HOURS=3            # Datenloch ab x Stunden ohne Wert über Mitternacht
OUTLIER_FACTOR=5        # Zähler: Tagesverbrauch > Faktor x Median; Messwert: Faktor x MAD (Hampel)
GRID_MINUTES=60         # Messwert: Raster der Füllpunkte bei Lücken
MARK_FIELD=korrektur_str   # Kennzeichnung manueller Punkte; leer = keine Kennzeichnung
